# ddai3  —  100.117.227.63
# RTX PRO 4500 Blackwell, 32.6 GB, sm_120
#
# Activate with SERVER_PROFILE=63.
#
# Everything about this box — model, VRAM split, services, ports, role wiring —
# lives in the shared base below, because ddai1-ddai4 are the same machine.
# Only what is genuinely per-host belongs here.
EXTENDS=common-blackwell-32gb

SERVER_NAME=ddai3

# Speech-to-text (gpu/stt/whisper) for the Maritime Advisor's microphone.
# On the GPU: int8_float16 large-v3-turbo takes 1.3 GB of the VRAM vLLM leaves
# unallocated and answers a 10 s question in ~1.7 s (cpu int8: 4.6 s). float16
# needs ~2.1 GB and OOMs here. Measured 2026-10-11.
# That room exists only once vLLM is up: a vLLM (re)starting beside a resident
# stt + Infinity finds 26.1 of the 26.35 GiB it asks for and crash-loops, so
# scripts/watchdog.sh stops both until vLLM is healthy (2026-10-12).
ENABLE_STT=true
STT_DEVICE=cuda
STT_COMPUTE_TYPE=int8_float16
