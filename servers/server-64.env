# ddai4  —  100.117.227.64
# RTX PRO 4500 Blackwell, 32.6 GB, sm_120
#
# Activate with SERVER_PROFILE=64.
#
# Everything about this box — model, VRAM split, services, ports, role wiring —
# lives in the shared base below, because ddai1-ddai4 are the same machine.
# Only what is genuinely per-host belongs here.
EXTENDS=common-blackwell-32gb

SERVER_NAME=ddai4

# Speech-to-text (gpu/stt/whisper), as ddai3 (server-63.env): cuda int8_float16
# takes ~1.3 GB of the VRAM vLLM leaves unallocated. Enabled 2026-10-20 so
# cee's advisor (ddfe5, pinned to this deepdrishti) can take spoken questions.
ENABLE_STT=true
STT_DEVICE=cuda
STT_COMPUTE_TYPE=int8_float16
